# Frontend Environment Variables

# Backend API URL the built bundle talks to.
# - Same-origin deployment (recommended): leave unset or use "/api" — the SPA
#   calls its own origin and the reverse proxy routes /api to the backend.
# - Separately hosted API: set the absolute URL, e.g. https://api.example.com/api
# NOTE: Vite inlines this value into dist/ at BUILD time. Never leave a
# developer-machine URL (like http://localhost:5000/api) in the file used for a
# production build.
VITE_API_URL=/api

# App Configuration
VITE_APP_NAME=WorkZen
VITE_APP_VERSION=1.0.0
